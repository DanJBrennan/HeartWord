{
  "name": "heartword",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous pipeline for Scripture videos in low-resource heart languages.",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build",
    "typecheck": "tsc -p src/server/tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "db:seed-characters": "tsx src/db/seed-characters.ts",
    "db:seed-control-room-voices": "tsx scripts/seed-control-room-voice-profiles.ts",
    "db:seed-control-room-briefs": "tsx scripts/seed-control-room-presentation-briefs.ts",
    "db:seed-control-room-red-team": "tsx scripts/seed-control-room-red-team-findings.ts",
    "db:recast-control-room-voices": "tsx scripts/recast-control-room-voices.ts",
    "calibrate:control-room-loudness": "tsx scripts/calibrate-control-room-presentation-loudness.ts",
    "evaluate:reviewed-evidence": "tsx scripts/evaluate-reviewed-evidence.ts",
    "report:mark4-readiness": "tsx scripts/report-mark4-readiness.ts",
    "watch:media": "tsx scripts/watch-media-generation.ts",
    "ltx:test": "tsx scripts/ltx-test.ts",
    "chapter:package": "tsx scripts/chapter-package.ts",
    "data:backup": "tsx scripts/disaster-backup.ts",
    "db:import-control-room-presentation": "python scripts/import-control-room-presentation-library.py C:\\Users\\danbr\\Downloads\\HeartWord_New_Sample_Exchanges.xlsx",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vosk-browser": "^0.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.20.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "vitest": "^2.1.1"
  }
}
