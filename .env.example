# HeartWord environment configuration.
# Copy to .env and fill in real values; .env itself is gitignored.

# Google Gemini API family — Nano Banana / Nano Banana Pro (image),
# Veo 3.1 Lite (video), Gemini Omni 1.1 (draft tier, keyframe-guided
# generation, targeted image editing). One key covers all of these.
GEMINI_API_KEY=

# Kling.ai Avatar API — lip-sync.
KLING_API_KEY_1=

# Where HeartWord's SQLite database and generated media live. Defaults to
# C:\Users\danbr\HeartWordData if unset — see docs/ARCHITECTURE.md's
# "Development Environment" section for why this is kept outside the
# OneDrive-synced repo.
HEARTWORD_DATA_DIR=
