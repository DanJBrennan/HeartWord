# HeartWord environment configuration.
# Copy to .env and fill in real values; .env itself is gitignored.

# Google Gemini API family — Nano Banana / Nano Banana Pro (image),
# Veo 3.1 Lite (video), Gemini Omni 1.1 (draft tier, keyframe-guided
# generation, targeted image editing), plus stage 3's text/JSON planning
# calls (gemini-2.5-flash, src/server/providers/gemini.ts). One key
# covers all of these.
GEMINI_API_KEY=
# Composer-directed instrumental music through Gemini's Interactions API.
GEMINI_MUSIC_MODEL=lyria-3.5

# OpenAI — added 2026-09-06 as an available alternative provider. Not
# currently used by any pipeline stage; stage 3 still calls Gemini.
OPENAI_API_KEY=

# ElevenLabs voice-changer (speech-to-speech) — audition/select each
# canonical character's voice, then re-voice their real Hatam dialogue
# (from stage 1's original_reading audio) into that voice for the
# composite cast master. Not text-to-speech -- no Hatam TTS model exists.
ELEVENLABS_API_KEY=

# Kling.ai Avatar API — lip-sync. Takes the ElevenLabs-voiced audio clip
# plus a scene keyframe and the character's headshot.
KLING_API_KEY_1=

# Where HeartWord's SQLite database and generated media live. Defaults to
# C:\Users\danbr\HeartWordData if unset — see docs/ARCHITECTURE.md's
# "Development Environment" section for why this is kept outside the
# OneDrive-synced repo.
HEARTWORD_DATA_DIR=

# Primary scene video backend. Veo and Kling remain available for comparison.
HEARTWORD_VIDEO_PROVIDER=ltx
# Local LTX Desktop access: SSH/SCP with noninteractive key authentication.
LTX_SSH_HOST=192.168.77.2
LTX_SSH_USER=danieljbrennan
# Optional absolute Mac path; defaults to the SSH user's ~/LTX-Inbox.
LTX_INBOX_DIR=
LTX_GENERATION_TIMEOUT_SECONDS=7200
# Supply LTX_TOKEN ONLY in the process environment. Do not put it in .env,
# this file, logs, source code, or any other project file. It is the masked
# Desktop backend/session token, not an LTX cloud API key. Copy it on the Mac,
# then in the PowerShell shell that starts HeartWord:
# $env:LTX_TOKEN = (ssh danieljbrennan@192.168.77.2 'pbpaste').Trim()
