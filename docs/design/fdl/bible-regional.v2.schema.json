{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heartword:fdl:bible-regional:2",
  "title": "Bible and approved regional identity extension v2 — separate authorities",
  "type": "object", "additionalProperties": false,
  "required": ["extensionVersion", "source", "regionalIdentity", "historicalSetting", "grounding", "gateRecordRefs"],
  "properties": {
    "extensionVersion": {"const": 2},
    "source": {"type": "object", "additionalProperties": false, "required": ["sourceBindingRef", "language", "book", "chapter", "verseRefs", "sourceIntervalRefs", "referencePurpose", "internalVerseTiming"], "properties": {
      "sourceBindingRef": {"$ref": "#/$defs/id"}, "language": {"$ref": "#/$defs/id"}, "book": {"$ref": "#/$defs/id"}, "chapter": {"type": "integer", "minimum": 1},
      "verseRefs": {"$ref": "#/$defs/ids"}, "sourceIntervalRefs": {"$ref": "#/$defs/ids"},
      "referencePurpose": {"const": "semantic_context_only"}, "internalVerseTiming": {"enum": ["exact", "approximate", "unresolved"]}
    }},
    "regionalIdentity": {"type": "object", "additionalProperties": false, "required": ["region", "medium", "appliesTo", "canonContextRef", "characterVersionRefs"], "properties": {
      "region": {"$ref": "#/$defs/id"}, "medium": {"const": "video"}, "appliesTo": {"const": "character_identity"},
      "canonContextRef": {"$ref": "#/$defs/id"}, "characterVersionRefs": {"$ref": "#/$defs/ids"}
    }},
    "historicalSetting": {"type": "object", "additionalProperties": false, "required": ["period", "place", "setVersionRefs", "approvedReconstructionRefs", "unknowns"], "properties": {
      "period": {"$ref": "#/$defs/id"}, "place": {"$ref": "#/$defs/id"}, "setVersionRefs": {"$ref": "#/$defs/ids"},
      "approvedReconstructionRefs": {"$ref": "#/$defs/ids"}, "unknowns": {"$ref": "#/$defs/ids"}
    }},
    "grounding": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["target", "authority", "refs", "limitations"], "properties": {
      "target": {"$ref": "#/$defs/id"}, "authority": {"enum": ["verified_source", "regional_canon", "approved_reconstruction", "visual_staging", "unknown"]},
      "refs": {"$ref": "#/$defs/ids"}, "limitations": {"type": "string"}
    }, "allOf": [{"if": {"properties": {"authority": {"enum": ["verified_source", "regional_canon", "approved_reconstruction"]}}}, "then": {"properties": {"refs": {"type": "array", "minItems": 1}}}}]}},
    "gateRecordRefs": {"type": "object", "additionalProperties": false, "required": ["videoEligibility", "citationScope", "sourceReview", "canonApproval", "historicalReconstruction", "fieldReview", "releaseApproval"], "properties": {
      "videoEligibility": {"$ref": "#/$defs/nullableRef"}, "citationScope": {"$ref": "#/$defs/nullableRef"},
      "sourceReview": {"$ref": "#/$defs/nullableRef"}, "canonApproval": {"$ref": "#/$defs/nullableRef"},
      "historicalReconstruction": {"$ref": "#/$defs/nullableRef"}, "fieldReview": {"$ref": "#/$defs/nullableRef"}, "releaseApproval": {"$ref": "#/$defs/nullableRef"}
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nullableRef": {"type": ["string", "null"], "minLength": 1}
  }
}
